# ============================================================
# DeepResearch 后端环境变量示例
# 复制本文件为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================

# ===== LLM 多厂商配置 =====
# 模型清单声明在 app/config/llm.yaml（providers + models）。
# 这里只放密钥；llm.yaml 里用 ${变量名} 占位引用。
DEEPSEEK_API_KEY=your-deepseek-key-here
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# QWEN_API_KEY=your-qwen-key-here

# LLM 调用可靠性
# 单次调用超时（秒）。draft/polish 生成长报告较慢，建议 >= 180。
LLM_TIMEOUT_SECONDS=240
# OpenAI 客户端重试次数
LLM_MAX_RETRIES=2
# 主模型失败后依次尝试的兜底模型（逗号分隔，留空 = 不启用 failover）
LLM_FALLBACK_MODELS=

# ===== 搜索（Tavily）=====
TAVILY_API_KEY=your-tavily-key-here
# 每条查询返回的结果数
TAVILY_MAX_RESULTS=3
# 搜索深度：basic / advanced
TAVILY_SEARCH_DEPTH=advanced

# ===== 研究深度（对应前端「快速/均衡/全面」三档）=====
# EFFORT_LOW_INITIAL_QUERIES=1
# EFFORT_LOW_MAX_ROUNDS=1
# EFFORT_MEDIUM_INITIAL_QUERIES=3
# EFFORT_MEDIUM_MAX_ROUNDS=3
# EFFORT_HIGH_INITIAL_QUERIES=5
# EFFORT_HIGH_MAX_ROUNDS=5

# ===== 写作子图 =====
# 审稿及格线 & 最大修订轮次
WRITING_PASS_SCORE=6.0
WRITING_MAX_REVISIONS=2

# ===== 并发 / 限流 =====
MAX_CONCURRENT_LLM=4
MAX_CONCURRENT_SEARCH=4
# 每 IP 每分钟最大请求数（固定窗口限流）
RATE_LIMIT_PER_MINUTE=60

# ===== 服务 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8010
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# 会话检查点 SQLite 文件路径（默认 backend/checkpoints.sqlite）
# CHECKPOINT_DB_PATH=checkpoints.sqlite

# ===== 结构化日志 =====
# 置为 1/true/yes 时输出 JSON 日志（便于日志采集），否则输出人读格式
LOG_JSON=0

# ===== 评估（LLM-as-Judge，可选）=====
# 评估裁判专用模型，与主程序角色映射解耦。
# 优先级：--judge-model 命令行 > EVAL_MODEL > EVAL_BASE_URL+EVAL_API_KEY > review 默认
EVAL_MODEL=deepseek-v4-pro
# 换独立厂商时搭配下面两项：
# EVAL_BASE_URL=https://api.openai.com/v1
# EVAL_API_KEY=your-eval-key-here
